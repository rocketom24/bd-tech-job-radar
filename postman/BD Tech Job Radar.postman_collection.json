                  "pm.test(\"exactly 1 unique view and 1 Apply click used\", () => { pm.expect(d.subscriptionStatus).to.eql(\"FREE\"); pm.expect(d.jobViews).to.include({ used: 1, limit: 10, remaining: 9 }); pm.expect(d.applyClicks).to.include({ used: 1, limit: 3, remaining: 2 }); });"
