      "name": "Jobs",
      "item": [
        {
          "name": "List all jobs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"data array of 25\", () => { pm.expect(body.data).to.be.an(\"array\"); pm.expect(body.data).to.have.lengthOf(25); });",
                  "pm.test(\"newest first\", () => { const t = body.data.map(j => Date.parse(j.createdAt)); pm.expect(t).to.eql([...t].sort((a, b) => b - a)); });",
                  "pm.test(\"summary only: no description / sourceUrl\", () => body.data.forEach(j => { pm.expect(j).to.not.have.property(\"description\"); pm.expect(j).to.not.have.property(\"sourceUrl\"); }));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/jobs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "jobs"
              ]
            }
          }
        },
