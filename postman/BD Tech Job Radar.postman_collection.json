    {
      "name": "Sources",
      "item": [
        {
          "name": "List sources",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"data array of 5\", () => { pm.expect(body.data).to.be.an(\"array\"); pm.expect(body.data).to.have.lengthOf(5); });",
                  "pm.test(\"fields and order\", () => { body.data.forEach(s => pm.expect(s).to.have.all.keys(\"id\", \"name\", \"type\", \"url\")); const n = body.data.map(s => s.name); pm.expect(n).to.eql([...n].sort()); });"
                ]
