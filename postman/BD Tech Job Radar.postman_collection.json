    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const u = pm.response.json().data;",
                  "pm.test(\"safe user only\", () => pm.expect(u).to.have.all.keys(\"id\", \"email\", \"subscriptionStatus\", \"createdAt\"));",
                  "pm.test(\"session cookie set\", () => pm.expect(pm.cookies.has(\"bdr_session\")).to.be.true);",
                  "pm.collectionVariables.set(\"authEmail\", u.email);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman-{{$timestamp}}@example.test\",\n  \"password\": \"a-secure-password\"\n}"
            }
          }
        },
