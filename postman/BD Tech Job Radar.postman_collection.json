                  "const b = pm.response.json();",
                  "pm.test(\"original URL returned\", () => pm.expect(b.applyUrl).to.match(/^https?:///));",
                  "pm.test(\"2 of 3 Apply clicks remain\", () => pm.expect(b.remaining).to.eql(2));"
                ]
