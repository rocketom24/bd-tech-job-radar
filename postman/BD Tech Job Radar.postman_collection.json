  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Per-IP rate limits (register 5/h, login 20/15min) read the header named by TRUSTED_IP_HEADER in .env.",
          "// Locally that is x-forwarded-for, so a random value keeps repeated collection runs from hitting 429.",
          "// Ignored (and harmless) when the server trusts no client IP header.",
          "pm.request.headers.upsert({ key: \"x-forwarded-for\", value: `10.${_.random(0, 255)}.${_.random(0, 255)}.${_.random(1, 254)}` });"
        ]
      }
    }
  ]
