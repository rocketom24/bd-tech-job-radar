# Copy to .env and fill in from the Neon dashboard (Connect button). Never commit .env.
# Pooled connection (host contains "-pooler"): used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection (no "-pooler"): used by migrations in Phase 4.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Rate limiting (required). Any random string of 32+ characters, e.g. `openssl rand -base64 48`.
# Used to HMAC client IPs / emails before they are stored. Use a DIFFERENT value per environment.
RATE_LIMIT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
# Header your hosting proxy sets/overwrites with the real client IP (Vercel: "x-real-ip").
# Leave UNSET unless a trusted proxy guarantees it; unset = all clients share one IP bucket (strict).
# Local tests set this to "x-forwarded-for" so each test user can send its own fake IP.
TRUSTED_IP_HEADER=""
