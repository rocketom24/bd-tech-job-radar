generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JobSourceType {
  GOVERNMENT
  COMPANY
  UNIVERSITY
  NGO
  PORTAL
  OTHER
}

enum SalaryPeriod {
  MONTHLY
  YEARLY
  HOURLY
}

enum SalaryDisclosure {
  DISCLOSED
  NEGOTIABLE
  NOT_DISCLOSED
}

model JobSource {
  id   Int           @id @default(autoincrement())
  name String
  type JobSourceType
  url  String
  jobs Job[]
}

model Job {
  id               Int               @id @default(autoincrement())
  title            String
  organization     String
  sector           String
  category         String
  location         String
  description      String
  salary           String            @default("") // legacy free-text display string; kept as is
  // Structured salary. All nullable: null salaryDisclosure = legacy/unknown row.
  // Cross-field rules are CHECK constraints in the migration SQL (not expressible here).
  salaryMin        Decimal?          @db.Decimal(12, 2)
  salaryMax        Decimal?          @db.Decimal(12, 2)
  salaryCurrency   String?           @db.Char(3)
  salaryPeriod     SalaryPeriod?
  salaryDisclosure SalaryDisclosure?
  experience       String            @default("")
  skills           String[]          @default([])
  deadline         DateTime?         @db.Timestamptz
  sourceId         Int
  sourceUrl        String
  verified         Boolean           @default(false)
  createdAt        DateTime          @default(now()) @db.Timestamptz

  jobViews    JobView[]
  applyClicks ApplyClick[]

  source JobSource @relation(fields: [sourceId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([sourceId])
  @@index([createdAt(sort: Desc)])
  @@index([sector])
  @@index([category])
}

model User {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  passwordHash       String? // scrypt, see lib/auth.ts; null = legacy user without a password
  subscriptionStatus String    @default("FREE")
  createdAt          DateTime  @default(now()) @db.Timestamptz
  usages             Usage[]
  jobViews           JobView[]
  applyClicks        ApplyClick[]
  sessions           Session[]
}

model Session {
  id         Int       @id @default(autoincrement())
  tokenHash  String    @unique // SHA-256 hex of the cookie token; the raw token is never stored
  userId     Int
  expiresAt  DateTime  @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz
  lastUsedAt DateTime? @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([expiresAt])
}

model Usage {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String
  createdAt DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([userId, createdAt])
}

// One row per (user, job): a UNIQUE job-detail view. Repeat views never insert again.
model JobView {
  id        Int      @id @default(autoincrement())
  userId    Int
  jobId     Int
  createdAt DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, jobId])
  @@index([jobId])
}

// One row per Apply click. Deliberately NOT unique: repeat clicks on one job each count.
model ApplyClick {
  id        Int      @id @default(autoincrement())
  userId    Int
  jobId     Int
  createdAt DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt])
  @@index([jobId])
}

// Fixed-window counters for rate limiting, shared by every app instance. `key` is an HMAC
// pseudonym (never a raw IP or email). One atomic upsert per check; expired windows are purged
// opportunistically by lib/rate-limit.ts.
model RateLimit {
  key         String
  windowStart DateTime @db.Timestamptz
  count       Int

  @@id([key, windowStart])
  @@index([windowStart])
}
